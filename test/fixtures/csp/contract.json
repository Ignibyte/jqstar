    { "name": "action", "capability": "action", "read": false, "write": false, "call": true },
    { "name": "<helper-root>", "capability": "helper", "read": false, "write": false, "call": true }
  ],
  "capabilities": [
    {
      "id": "primitive",
      "reads": "No properties except the reviewed string members on string values.",
      "writes": "None.",
      "calls": "None.",
      "result": "null, boolean, finite number, string, or undefined."
    },
    {
      "id": "plain-data",
      "reads": "Own data descriptors with safe string keys only; absence returns undefined.",
      "writes": "None after a value leaves the state capability.",
      "calls": "No function-valued property can be called.",
      "result": "Primitive, plain-data, string, or array with cycle tracking."
    },
    {
      "id": "state",
      "reads": "Safe signal names and own data paths through the framework state adapter.",
      "writes": "Signal roots and existing or new safe state paths only.",
      "calls": "None.",
      "result": "State, primitive, plain-data, string, or array."
    },
    {
      "id": "computed",
      "reads": "Safe committed computed names and safe returned data paths.",
      "writes": "None.",
      "calls": "None.",
      "result": "Primitive, plain-data, string, or array."
    },
    {
      "id": "event",
      "reads": "type, key, code, button, buttons, detail, target, currentTarget, defaultPrevented, and timeStamp.",
      "writes": "None.",
      "calls": "preventDefault and stopPropagation only.",
      "result": "Primitive, plain-data, or same-realm DOM element."
    },
    {
      "id": "arguments",
      "reads": "length and integer indexes within the bounded argument collection.",
      "writes": "None.",
      "calls": "Reviewed array methods only.",
      "result": "Primitive, plain-data, string, or array."
    },
    {
      "id": "dom-element",
      "reads": "id, name, type, tagName, value, checked, disabled, textContent, dataset, and ownerDocument identity only.",
      "writes": "None directly; reviewed jQuery methods own DOM mutation.",
      "calls": "None.",
      "result": "Primitive, plain-data dataset view, or same-realm DOM identity."
    },
    {
      "id": "jquery",
      "reads": "length and integer indexes only.",
      "writes": "Only through reviewed jQuery methods.",
      "calls": "The jQuery constructor and reviewed method table only.",
      "result": "Primitive or tracked bounded jQuery value according to the method table."
    },
    {
      "id": "string",
      "reads": "length only.",
      "writes": "None.",
      "calls": "Reviewed non-callback string methods only.",
      "result": "Primitive string, number, or boolean."
    },
    {
      "id": "array",
      "reads": "length and bounded nonnegative integer indexes.",
      "writes": "None except when the array is reached through an assignable state path.",
      "calls": "Reviewed non-callback, non-mutating array methods only.",
      "result": "Primitive or bounded array."
    },
    {
      "id": "action",
      "reads": "None.",
      "writes": "Actions retain their registered application authority.",
      "calls": "A literal registered action name through @name or action(name, ...).",
      "result": "Primitive, inert plain data, or approved async result; callable and live-object results are denied."
    },
    {
      "id": "helper",
      "reads": "Only the committed dotted helper path used as the call target.",
      "writes": "Helpers retain their installed plugin authority.",
      "calls": "A committed helper leaf only.",
      "result": "Primitive, inert plain data, or approved async result; callable and live-object results are denied."
    },
    {
      "id": "approved-async",
      "reads": "No then property is exposed.",
      "writes": "None.",
      "calls": "Adopted once only by await or the engine result boundary.",
      "result": "The normalized action/helper result or CSP_ASYNC_REJECTION."
    },
    {
      "id": "call-result",
      "reads": "Own safe data descriptors after capability-result validation.",
      "writes": "None.",
      "calls": "None; a returned function never becomes a callee.",
      "result": "Primitive, inert plain data, string, or array."
    }
  ],
