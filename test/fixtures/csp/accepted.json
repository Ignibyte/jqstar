  "cases": [
    {
      "id": "literal-array",
      "entryKind": "value",
      "source": "[null, true, false, 0, 1.5, \"ok\"]",
      "covers": {
        "productions": [
          "value-input",
          "assignment-expression",
          "conditional-expression",
          "nullish-expression",
          "logical-or-expression",
          "logical-and-expression",
          "equality-expression",
          "relational-expression",
          "additive-expression",
          "multiplicative-expression",
          "unary-expression",
          "update-expression",
          "member-expression",
          "primary-expression",
          "literal",
          "array-literal"
        ],
        "nodes": ["array-literal", "literal"],
        "capabilities": ["primitive", "array"],
        "operators": []
      },
      "expected": { "outcome": "value", "value": [null, true, false, 0, 1.5, "ok"] }
    },
    {
      "id": "object-literal",
