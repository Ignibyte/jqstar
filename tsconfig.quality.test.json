{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "types": ["jquery", "node", "vitest/globals"]
  },
  "include": [
    "test/**/*.ts",
    "e2e/**/*.ts",
    "example/**/*.ts",
    "scripts/**/*.d.mts",
    "*.config.ts",
    "src/**/*.d.ts"
  ]
}
