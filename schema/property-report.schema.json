{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ignibyte.github.io/jqstar/schema/property-report.schema.json",
  "type": "object",
  "required": [
    "schema",
    "runId",
    "mode",
    "status",
    "startedAt",
    "finishedAt",
    "seed",
    "runs",
    "configuredRuns",
    "effectiveRuns",
    "properties",
    "replay",
    "discoveredFailure",
    "exitCode",
    "failures"
  ],
  "properties": {
    "schema": { "const": "jqstar-property-report/1" },
    "runId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["delivery-replay", "random-audit"] },
    "status": { "enum": ["pass", "fail", "error"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "seed": { "type": "integer" },
    "runs": { "type": "integer", "minimum": 1 },
    "configuredRuns": { "type": "integer", "minimum": 1 },
    "effectiveRuns": { "type": "integer", "minimum": 0 },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "seed",
          "configuredRuns",
          "effectiveRuns",
          "skips",
          "shrinks",
          "status",
          "replayPath",
          "pathConsumed"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "seed": { "type": "integer" },
          "configuredRuns": { "type": "integer", "minimum": 1 },
          "effectiveRuns": { "type": "integer", "minimum": 0 },
          "skips": { "type": "integer", "minimum": 0 },
          "shrinks": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["pass", "fail"] },
          "replayPath": { "type": ["string", "null"] },
          "pathConsumed": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "replay": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["property", "path", "consumedBy"],
          "properties": {
            "property": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "consumedBy": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      ]
    },
    "discoveredFailure": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "counterexample": { "type": "string" },
            "path": { "type": "string" }
          },
          "minProperties": 1,
          "additionalProperties": false
        }
      ]
    },
    "exitCode": { "type": "integer" },
    "signal": { "type": ["string", "null"] },
    "failures": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "pass" } }, "required": ["status"] },
      "then": {
        "properties": {
          "exitCode": { "const": 0 },
          "effectiveRuns": { "type": "integer", "minimum": 1 },
          "properties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": { "status": { "const": "pass" } }
            }
          },
          "failures": { "type": "array", "maxItems": 0 }
        }
      }
    }
  ],
  "additionalProperties": true
}
