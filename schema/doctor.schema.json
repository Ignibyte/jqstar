{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jqstar.com/schema/doctor.schema.json",
  "title": "jQStar offline doctor and configuration upgrade documents",
  "oneOf": [
    {
      "$ref": "#/$defs/report"
    },
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/journal"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/migrateSummary"
    },
    {
      "$ref": "#/$defs/ownership"
    }
  ],
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^JQS_[A-Z_]+$",
          "maxLength": 64
        },
        "severity": {
          "enum": ["error", "warning", "unknown", "info"]
        },
        "evidence": {
          "enum": [
            "manifest",
            "lock",
            "installed",
            "unknown",
            "explicit-input",
            "plugin-metadata",
            "node-version",
            "config-metadata",
            "ownership-metadata",
            "user-summary",
            "rules",
            "input",
            "limit",
            "internal"
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 512
        },
        "path": {
          "type": "string",
          "maxLength": 256
        },
        "package": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "observed": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "expected": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "documentation": {
          "type": "string",
          "format": "uri",
          "maxLength": 512
        },
        "correction": {
          "type": "string",
          "maxLength": 512
        }
      },
      "required": [
        "code",
        "severity",
        "evidence",
        "summary",
        "path",
        "package",
        "observed",
        "expected",
        "documentation",
        "correction"
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "jqstar-doctor-report/1"
        },
        "version": {
          "type": ["string", "null"],
          "maxLength": 64
        },
        "project": {
          "const": "."
        },
        "rulesReviewedAt": {
          "type": ["string", "null"],
          "format": "date"
        },
        "complete": {
          "type": "boolean"
        },
        "exitCode": {
          "enum": [0, 1, 2]
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "errors": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "warnings": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "info": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            }
          },
          "required": ["errors", "warnings", "unknown", "info"]
        },
        "scan": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "files": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "packageRecords": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "workspaceManifests": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["files", "bytes", "packageRecords", "workspaceManifests"]
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": {
              "const": "jquery-star.json"
            },
            "backup": {
              "type": ["string", "null"],
              "maxLength": 256
            },
            "journal": {
              "type": ["string", "null"],
              "maxLength": 256
            },
            "instruction": {
              "type": "string",
              "maxLength": 512
            }
          },
          "required": ["target", "backup", "journal", "instruction"]
        }
      },
      "required": [
        "schema",
        "version",
        "project",
        "rulesReviewedAt",
        "complete",
        "exitCode",
        "summary",
        "scan",
        "diagnostics"
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "jqstar-config-plan/1"
        },
        "action": {
          "enum": ["no-op", "upgrade-config"]
        },
        "root": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 4096
            },
            "device": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "inode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["path", "device", "inode"]
        },
        "target": {
          "const": "jquery-star.json"
        },
        "from": {
          "enum": [0, 1]
        },
        "to": {
          "const": 1
        },
        "before": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "canonicalSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "mode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 420
            },
            "identity": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "device": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "inode": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["device", "inode"]
            },
            "rawMode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4095
            }
          },
          "required": ["sha256", "canonicalSha256", "mode", "rawMode", "identity"]
        },
        "after": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "canonicalSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "mode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 420
            }
          },
          "required": ["sha256", "canonicalSha256", "mode"]
        },
        "operations": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "enum": ["add", "replace"]
              },
              "path": {
                "const": "/configVersion"
              },
              "value": {
                "const": 1
              }
            },
            "required": ["op", "path", "value"]
          }
        },
        "backup": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "journal": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "rollback": {
          "type": ["array", "null"],
          "maxItems": 6,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        }
      },
      "required": [
        "schema",
        "action",
        "root",
        "target",
        "from",
        "to",
        "before",
        "after",
        "operations",
        "backup",
        "journal",
        "rollback"
      ]
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "jqstar-config-journal/1"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      },
      "required": ["schema", "plan"]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "jqstar-config-result/1"
        },
        "action": {
          "enum": ["no-op", "applied", "rolled-back"]
        },
        "target": {
          "const": "jquery-star.json"
        },
        "root": {
          "type": "string",
          "maxLength": 4096
        },
        "beforeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "afterSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "backup": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "journal": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "rollback": {
          "type": ["array", "null"],
          "maxItems": 6,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        }
      },
      "required": [
        "schema",
        "action",
        "target",
        "root",
        "beforeSha256",
        "afterSha256",
        "backup",
        "journal",
        "rollback"
      ]
    },
    "migrateSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "jqstar-migrate-summary/1"
        },
        "jqueryVersion": {
          "type": "string",
          "maxLength": 64
        },
        "migrateVersion": {
          "type": "string",
          "maxLength": 64
        },
        "categories": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "category": {
                "enum": ["api", "event", "selector", "ajax", "css", "data", "other"]
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              }
            },
            "required": ["category", "count"]
          }
        }
      },
      "required": ["schema", "jqueryVersion", "migrateVersion", "categories"]
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "jqstar-registry-ownership/1"
        },
        "package": {
          "const": "jquery-star"
        },
        "version": {
          "type": "string",
          "maxLength": 64
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "output": {
              "type": "string",
              "maxLength": 256
            },
            "blocksOutput": {
              "type": "string",
              "maxLength": 256
            }
          },
          "required": ["output"]
        }
      },
      "required": ["schema", "package", "version", "configuration"]
    }
  }
}
