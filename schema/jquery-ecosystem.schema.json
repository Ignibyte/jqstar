{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jqstar.com/schema/jquery-ecosystem.schema.json",
  "title": "jQStar jQuery ecosystem contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "reviewedAt",
    "expiresAt",
    "reviewPolicy",
    "product",
    "projects",
    "uiCapabilityMap",
    "downstream"
  ],
  "properties": {
    "$schema": { "const": "../schema/jquery-ecosystem.schema.json" },
    "schema": { "const": "jqstar-jquery-ecosystem/1" },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "reviewPolicy": { "$ref": "#/$defs/reviewPolicy" },
    "product": { "$ref": "#/$defs/product" },
    "projects": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/project" }
    },
    "uiCapabilityMap": {
      "type": "array",
      "minItems": 20,
      "items": { "$ref": "#/$defs/uiCapability" }
    },
    "downstream": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/downstream" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "maxLength": 600 },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "reviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumAgeDays", "triggers", "changeProcess"],
      "properties": {
        "maximumAgeDays": { "type": "integer", "minimum": 1, "maximum": 183 },
        "triggers": { "$ref": "#/$defs/stringList" },
        "changeProcess": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "names",
        "positioning",
        "disclaimer",
        "trademarkPolicy",
        "attribution",
        "allowedUses",
        "forbiddenClaims",
        "surfaceReview",
        "futureProposalPrerequisites"
      ],
      "properties": {
        "names": {
          "type": "object",
          "additionalProperties": false,
          "required": ["product", "package", "cli", "markup", "site", "legacyCheckout"],
          "properties": {
            "product": { "const": "jQStar" },
            "package": { "const": "jquery-star" },
            "cli": { "const": "jqstar" },
            "markup": { "const": "data-jqs" },
            "site": { "const": "jqstar.com" },
            "legacyCheckout": { "const": "jqdatastar" }
          }
        },
        "positioning": { "$ref": "#/$defs/nonEmptyString" },
        "disclaimer": { "$ref": "#/$defs/nonEmptyString" },
        "trademarkPolicy": { "type": "string", "format": "uri", "pattern": "^https://" },
        "attribution": { "$ref": "#/$defs/nonEmptyString" },
        "allowedUses": { "$ref": "#/$defs/stringList" },
        "forbiddenClaims": { "$ref": "#/$defs/stringList" },
        "surfaceReview": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["surface", "evidence", "result"],
            "properties": {
              "surface": {
                "enum": [
                  "package-metadata",
                  "readme",
                  "website-titles-copy",
                  "social-image-assets",
                  "repository-metadata-topics",
                  "examples",
                  "migration-guides",
                  "release-notes"
                ]
              },
              "evidence": { "$ref": "#/$defs/stringList" },
              "result": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "futureProposalPrerequisites": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "url", "reviewedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "kind": {
          "enum": ["status", "release", "support", "migration", "maintenance", "catalog"]
        },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "reviewedAt": { "type": "string", "format": "date-time" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "package",
        "officialStatus",
        "reviewedRelease",
        "releaseKind",
        "maintenanceStatement",
        "disposition",
        "runtimePolicy",
        "jqstarRole",
        "testedVersions",
        "supportedRange",
        "ownerTickets",
        "nonGoals",
        "recheckTriggers",
        "sources"
      ],
      "properties": {
        "id": {
          "enum": ["jquery-core", "jquery-migrate", "jquery-ui", "jquery-mobile", "sizzle", "qunit"]
        },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "package": { "type": "string", "pattern": "^[a-z0-9@/._-]+$" },
        "officialStatus": { "enum": ["impact", "at-large", "archived", "jquery-companion"] },
        "reviewedRelease": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        },
        "releaseKind": { "enum": ["current-stable", "last-stable"] },
        "maintenanceStatement": { "$ref": "#/$defs/nonEmptyString" },
        "disposition": { "enum": ["integrate", "coexist-and-migrate", "migrate-only", "ignore"] },
        "runtimePolicy": {
          "enum": [
            "peer-foundation",
            "development-test-only",
            "application-opt-in",
            "external-only",
            "absent"
          ]
        },
        "jqstarRole": { "$ref": "#/$defs/nonEmptyString" },
        "testedVersions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
        },
        "supportedRange": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 80 }, { "type": "null" }]
        },
        "ownerTickets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\d{4}$" }
        },
        "nonGoals": { "$ref": "#/$defs/stringList" },
        "recheckTriggers": { "$ref": "#/$defs/stringList" },
        "sources": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "uiCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "legacyCapability",
        "classification",
        "jqstarCounterparts",
        "contractDifference",
        "sourceUrl",
        "ownerTicket"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^jquery-ui\\.[a-z0-9.-]+$" },
        "category": {
          "enum": ["widget", "interaction", "utility", "effects", "theme", "contract", "extension"]
        },
        "legacyCapability": { "$ref": "#/$defs/nonEmptyString" },
        "classification": {
          "enum": [
            "catalog-counterpart",
            "semantic-api-migration",
            "external-coexistence",
            "no-equivalent"
          ]
        },
        "jqstarCounterparts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "contractDifference": { "$ref": "#/$defs/nonEmptyString" },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "ownerTicket": { "const": "0039" }
      }
    },
    "downstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "projectId", "ticket", "requirements"],
      "properties": {
        "id": { "type": "string", "pattern": "^jquery-ecosystem\\.[a-z0-9.-]+$" },
        "projectId": {
          "enum": ["jquery-migrate", "jquery-ui", "jquery-mobile", "qunit"]
        },
        "ticket": { "enum": ["0014", "0032", "0039", "0040"] },
        "requirements": { "$ref": "#/$defs/stringList" }
      }
    }
  }
}
