{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ignibyte.github.io/jqstar/schema/release-candidate.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "schema",
    "status",
    "runId",
    "generatedAt",
    "identity",
    "preflight",
    "environment",
    "artifact",
    "reproducibility",
    "prerequisites",
    "quality",
    "consumers",
    "security",
    "subordinateReports",
    "handoff",
    "redactions"
  ],
  "properties": {
    "$schema": {
      "const": "https://ignibyte.github.io/jqstar/schema/release-candidate.schema.json"
    },
    "schema": { "const": "jqstar-release-candidate/1" },
    "status": { "const": "pass" },
    "runId": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}-[0-9]{3}Z-[0-9]+$"
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "identity": { "$ref": "#/$defs/identity" },
    "preflight": { "$ref": "#/$defs/preflight" },
    "environment": { "$ref": "#/$defs/environment" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "reproducibility": { "$ref": "#/$defs/reproducibility" },
    "prerequisites": { "$ref": "#/$defs/prerequisites" },
    "quality": { "$ref": "#/$defs/quality" },
    "consumers": { "$ref": "#/$defs/consumers" },
    "security": { "$ref": "#/$defs/security" },
    "subordinateReports": { "$ref": "#/$defs/subordinateReports" },
    "handoff": { "$ref": "#/$defs/handoff" },
    "redactions": { "$ref": "#/$defs/redactions" }
  },
  "additionalProperties": false,
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sha512": { "type": "string", "pattern": "^[a-f0-9]{128}$" },
    "nonemptyString": { "type": "string", "minLength": 1 },
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonemptyString" }
    },
    "identity": {
      "type": "object",
      "required": [
        "package",
        "version",
        "branch",
        "commit",
        "tree",
        "sourceDateEpoch",
        "packageJsonSha256",
        "lockfileSha256",
        "contractSha256"
      ],
      "properties": {
        "package": { "const": "jquery-star" },
        "version": { "const": "1.0.0" },
        "branch": { "const": "feat/stable-platform-release" },
        "commit": { "$ref": "#/$defs/sha1" },
        "tree": { "$ref": "#/$defs/sha1" },
        "sourceDateEpoch": { "type": "integer", "minimum": 1 },
        "packageJsonSha256": { "$ref": "#/$defs/sha256" },
        "lockfileSha256": { "$ref": "#/$defs/sha256" },
        "contractSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "preflight": {
      "type": "object",
      "required": [
        "cleanWorkingTree",
        "committedSource",
        "nonShallow",
        "expectedBranch",
        "tagAbsent",
        "submodulesClean",
        "lockfileClean",
        "ignoredProductionInputs",
        "environmentNames",
        "redacted"
      ],
      "properties": {
        "cleanWorkingTree": { "const": true },
        "committedSource": { "const": true },
        "nonShallow": { "const": true },
        "expectedBranch": { "const": true },
        "tagAbsent": { "const": true },
        "submodulesClean": { "const": true },
        "lockfileClean": { "const": true },
        "ignoredProductionInputs": { "type": "array", "maxItems": 0 },
        "environmentNames": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        },
        "redacted": { "const": true }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "node",
        "npm",
        "platform",
        "architecture",
        "typescript",
        "playwright",
        "browsers"
      ],
      "properties": {
        "node": { "type": "string", "pattern": "^v[0-9]+\\." },
        "npm": { "type": "string", "pattern": "^[0-9]+\\." },
        "platform": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "typescript": { "type": "string", "pattern": "^Version [0-9]+\\." },
        "playwright": { "type": "string", "pattern": "^Version [0-9]+\\." },
        "browsers": {
          "type": "object",
          "required": ["chromium", "firefox", "webkit"],
          "properties": {
            "chromium": { "$ref": "#/$defs/browserVersion" },
            "firefox": { "$ref": "#/$defs/browserVersion" },
            "webkit": { "$ref": "#/$defs/browserVersion" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "browserVersion": {
      "type": "object",
      "required": ["version"],
      "properties": { "version": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": ["path", "mode", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "^(?:/|[A-Za-z]:[\\\\/])" }
        },
        "mode": { "type": "string", "pattern": "^[0-7]{4}$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "filename",
        "bytes",
        "sha256",
        "sha512",
        "npmIntegrity",
        "npmShasum",
        "fileCount",
        "files",
        "websiteArchive",
        "licenseNotices"
      ],
      "properties": {
        "filename": { "const": "jquery-star-1.0.0.tgz" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sha512": { "$ref": "#/$defs/sha512" },
        "npmIntegrity": {
          "type": "string",
          "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"
        },
        "npmShasum": { "$ref": "#/$defs/sha1" },
        "fileCount": { "type": "integer", "minimum": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/file" }
        },
        "websiteArchive": {
          "type": "object",
          "required": ["path", "bytes", "sha256"],
          "properties": {
            "path": { "const": "demo-dist/site.br" },
            "bytes": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        "licenseNotices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?:LICENSE|NOTICE(?:\\.md)?)$" }
        }
      },
      "additionalProperties": false
    },
    "reproducibility": {
      "type": "object",
      "required": [
        "builds",
        "byteIdentical",
        "manifestsIdentical",
        "workspacesIndependent",
        "cleanup"
      ],
      "properties": {
        "builds": { "const": 2 },
        "byteIdentical": { "const": true },
        "manifestsIdentical": { "const": true },
        "workspacesIndependent": { "const": true },
        "cleanup": {
          "type": "object",
          "required": ["success", "failure", "timeout", "sighup", "sigint", "sigterm"],
          "properties": {
            "success": { "const": "removed" },
            "failure": { "const": "removed" },
            "timeout": { "const": "removed" },
            "sighup": { "const": "removed" },
            "sigint": { "const": "removed" },
            "sigterm": { "const": "removed" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "required": ["id", "result"],
      "properties": {
        "id": { "type": "string", "pattern": "^AC-[0-9]{2}$" },
        "result": { "enum": ["Pass", "Approved-Disposition"] }
      },
      "additionalProperties": false
    },
    "ticket": {
      "type": "object",
      "required": ["id", "path", "status", "sha256", "criteria"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]{4}$" },
        "path": { "type": "string", "pattern": "^docs/tickets/[0-9]{4}-[a-z0-9-]+\\.md$" },
        "status": { "enum": ["done", "declined"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/criterion" }
        }
      },
      "additionalProperties": false
    },
    "prerequisites": {
      "type": "object",
      "required": ["required", "audited", "criterionCount", "tickets"],
      "properties": {
        "required": { "const": 33 },
        "audited": { "const": 33 },
        "criterionCount": { "type": "integer", "minimum": 33 },
        "tickets": {
          "type": "array",
          "minItems": 33,
          "maxItems": 33,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ticket" }
        }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "status": { "const": "pass" }
      },
      "additionalProperties": false
    },
    "qualityRun": {
      "type": "object",
      "required": ["mode", "command", "report", "sha256", "status", "gates"],
      "properties": {
        "mode": { "enum": ["full-audit", "delivery"] },
        "command": { "type": "string", "minLength": 1 },
        "report": { "type": "string", "pattern": "^\\.git/jqstar/runs/.+/report\\.json$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "status": { "const": "pass" },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/gate" }
        }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": ["runs"],
      "properties": {
        "runs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/qualityRun" },
                { "type": "object", "properties": { "mode": { "const": "full-audit" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/qualityRun" },
                { "type": "object", "properties": { "mode": { "const": "delivery" } } }
              ]
            }
          ],
          "items": false
        }
      },
      "additionalProperties": false
    },
    "consumers": {
      "type": "object",
      "required": ["subject", "packageReport", "sha256", "names"],
      "properties": {
        "subject": { "const": "exact-tarball" },
        "packageReport": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "names": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "evidenceFile": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "auditEvidence": {
      "type": "object",
      "required": ["path", "sha256", "source", "retrievedAt", "vulnerabilityCount"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source": { "const": "npm audit --omit=dev" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "vulnerabilityCount": { "const": 0 }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "required": ["sbom", "licenses", "audit", "secretScan", "generatedArtifactScan"],
      "properties": {
        "sbom": { "$ref": "#/$defs/evidenceFile" },
        "licenses": { "$ref": "#/$defs/evidenceFile" },
        "audit": { "$ref": "#/$defs/auditEvidence" },
        "secretScan": { "const": "pass" },
        "generatedArtifactScan": { "const": "pass" }
      },
      "additionalProperties": false
    },
    "subordinateReports": {
      "type": "object",
      "required": ["package", "release", "static", "browser"],
      "properties": {
        "package": { "$ref": "#/$defs/evidenceFile" },
        "release": { "$ref": "#/$defs/evidenceFile" },
        "static": { "$ref": "#/$defs/evidenceFile" },
        "browser": { "$ref": "#/$defs/evidenceFile" }
      },
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "required": [
        "expectedTag",
        "npmDistTag",
        "releaseNotes",
        "readOnlyCommands",
        "approvalRequiredCommands",
        "rollback"
      ],
      "properties": {
        "expectedTag": { "const": "v1.0.0" },
        "npmDistTag": { "const": "latest" },
        "releaseNotes": { "const": "CHANGELOG.md" },
        "readOnlyCommands": { "$ref": "#/$defs/stringArray" },
        "approvalRequiredCommands": { "$ref": "#/$defs/stringArray" },
        "rollback": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "redactions": {
      "type": "object",
      "required": ["absolutePaths", "environmentValues", "credentials", "privateSource"],
      "properties": {
        "absolutePaths": { "const": "absent" },
        "environmentValues": { "const": "absent" },
        "credentials": { "const": "absent" },
        "privateSource": { "const": "absent" }
      },
      "additionalProperties": false
    }
  }
}
