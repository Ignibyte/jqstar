{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ignibyte.github.io/jqstar/schema/csp-expression-contract.schema.json",
  "title": "jQStar CSP expression contract manifests",
  "oneOf": [
    { "$ref": "#/$defs/contract" },
    { "$ref": "#/$defs/acceptedCorpus" },
    { "$ref": "#/$defs/rejectedCorpus" },
    { "$ref": "#/$defs/contextManifest" },
    { "$ref": "#/$defs/conformanceMap" }
  ],
  "$defs": {
    "grammarVersion": { "const": "jqstar-csp-expression/1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "referenceList": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "methodList": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
      "uniqueItems": true
    },
    "manifestHeader": {
      "type": "object",
      "required": ["$schema", "schema", "grammarVersion", "ownerTicket"],
      "properties": {
        "$schema": { "const": "../../../schema/csp-expression-contract.schema.json" },
        "schema": { "type": "string" },
        "grammarVersion": { "$ref": "#/$defs/grammarVersion" },
        "ownerTicket": { "enum": ["0015", "0034", "0035"] }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startOffset", "endOffset", "startLine", "startColumn", "endLine", "endColumn"],
      "properties": {
        "startOffset": { "type": "integer", "minimum": 0 },
        "endOffset": { "type": "integer", "minimum": 0 },
        "startLine": { "type": "integer", "minimum": 1 },
        "startColumn": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 1 }
      }
    },
    "limitName": {
      "enum": [
        "sourceLength",
        "tokens",
        "nesting",
        "astNodes",
        "literalEntries",
        "pathSegments",
        "callArguments",
        "evaluationSteps",
        "collectionSize",
        "asyncChain"
      ]
    },
    "limitVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "relation", "value"],
      "properties": {
        "name": { "$ref": "#/$defs/limitName" },
        "relation": { "enum": ["at", "above"] },
        "value": { "type": "integer", "minimum": 0 }
      }
    },
    "contract": {
      "allOf": [
        { "$ref": "#/$defs/manifestHeader" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "$schema",
            "schema",
            "grammarVersion",
            "ownerTicket",
            "sourceEncoding",
            "entryKinds",
            "tokenKinds",
            "productions",
            "nodeKinds",
            "bindings",
            "capabilities",
            "diagnostics",
            "limits",
            "operators",
            "methods",
            "threatCategories"
          ],
          "properties": {
            "$schema": {},
            "schema": { "const": "jqstar-csp-contract/1" },
            "grammarVersion": {},
            "ownerTicket": { "const": "0015" },
            "sourceEncoding": { "const": "utf-16-code-units" },
            "entryKinds": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [{ "const": "value" }, { "const": "statement" }],
              "items": false
            },
            "tokenKinds": { "$ref": "#/$defs/referenceList" },
            "productions": { "$ref": "#/$defs/referenceList" },
            "nodeKinds": { "$ref": "#/$defs/referenceList" },
            "bindings": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "capability", "read", "write", "call"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "capability": { "$ref": "#/$defs/id" },
                  "read": { "type": "boolean" },
                  "write": { "type": "boolean" },
                  "call": { "type": "boolean" }
                }
              }
            },
            "capabilities": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "reads", "writes", "calls", "result"],
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "reads": { "type": "string", "minLength": 1 },
                  "writes": { "type": "string", "minLength": 1 },
                  "calls": { "type": "string", "minLength": 1 },
                  "result": { "type": "string", "minLength": 1 }
                }
              }
            },
            "diagnostics": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "code", "phase"],
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "code": { "type": "string", "pattern": "^CSP_[A-Z0-9_]+$" },
                  "phase": { "enum": ["compile", "evaluate"] }
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceLength",
                "tokens",
                "nesting",
                "astNodes",
                "literalEntries",
                "pathSegments",
                "callArguments",
                "evaluationSteps",
                "collectionSize",
                "asyncChain"
              ],
              "properties": {
                "sourceLength": { "const": 2048 },
                "tokens": { "const": 512 },
                "nesting": { "const": 16 },
                "astNodes": { "const": 256 },
                "literalEntries": { "const": 64 },
                "pathSegments": { "const": 8 },
                "callArguments": { "const": 8 },
                "evaluationSteps": { "const": 128 },
                "collectionSize": { "const": 128 },
                "asyncChain": { "const": 8 }
              }
            },
            "operators": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "symbol", "precedence", "associativity"],
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "symbol": { "type": "string", "minLength": 1 },
                  "precedence": { "type": "integer", "minimum": 1 },
                  "associativity": { "enum": ["left", "right", "prefix", "postfix"] }
                }
              }
            },
            "methods": {
              "type": "object",
              "additionalProperties": false,
              "required": ["jquery", "string", "array", "event"],
              "properties": {
                "jquery": { "$ref": "#/$defs/methodList" },
                "string": { "$ref": "#/$defs/methodList" },
                "array": { "$ref": "#/$defs/methodList" },
                "event": { "$ref": "#/$defs/methodList" }
              }
            },
            "threatCategories": { "$ref": "#/$defs/referenceList" }
          }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productions", "nodes", "capabilities", "operators"],
      "properties": {
        "productions": { "$ref": "#/$defs/referenceList" },
        "nodes": { "$ref": "#/$defs/referenceList" },
        "capabilities": { "$ref": "#/$defs/referenceList" },
        "operators": { "$ref": "#/$defs/referenceList" }
      }
    },
    "astNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "span"],
      "properties": {
        "kind": { "$ref": "#/$defs/id" },
        "span": { "$ref": "#/$defs/span" },
        "children": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "uniqueItems": true
        }
      }
    },
    "acceptedCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entryKind", "source", "covers", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "entryKind": { "enum": ["value", "statement"] },
        "source": { "type": "string" },
        "covers": { "$ref": "#/$defs/coverage" },
        "ast": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "nodes"],
          "properties": {
            "root": { "type": "integer", "minimum": 0 },
            "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/astNode" } }
          }
        },
        "fixture": { "$ref": "#/$defs/id" },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome"],
          "properties": {
            "outcome": {
              "enum": ["compiled", "value", "state", "async-value", "effect", "undefined"]
            },
            "value": true,
            "state": { "type": "object" },
            "calls": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["target", "arguments"],
                "properties": {
                  "target": { "type": "string", "minLength": 1 },
                  "arguments": { "type": "array" }
                }
              }
            }
          }
        },
        "limit": { "$ref": "#/$defs/limitVector" }
      }
    },
    "acceptedCorpus": {
      "allOf": [
        { "$ref": "#/$defs/manifestHeader" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["$schema", "schema", "grammarVersion", "ownerTicket", "cases"],
          "properties": {
            "$schema": {},
            "schema": { "const": "jqstar-csp-accepted/1" },
            "grammarVersion": {},
            "ownerTicket": { "const": "0034" },
            "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/acceptedCase" } }
          }
        }
      ]
    },
    "diagnosticExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "phase", "span", "partialEffects"],
      "properties": {
        "code": { "type": "string", "pattern": "^CSP_[A-Z0-9_]+$" },
        "phase": { "enum": ["compile", "evaluate"] },
        "span": { "$ref": "#/$defs/span" },
        "partialEffects": { "const": false }
      }
    },
    "rejectedCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entryKind", "source", "diagnostic"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "entryKind": { "enum": ["value", "statement"] },
        "source": true,
        "fixture": { "$ref": "#/$defs/id" },
        "category": { "$ref": "#/$defs/id" },
        "diagnostic": { "$ref": "#/$defs/diagnosticExpectation" },
        "limit": { "$ref": "#/$defs/limitVector" }
      }
    },
    "rejectedCorpus": {
      "allOf": [
        { "$ref": "#/$defs/manifestHeader" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["$schema", "schema", "grammarVersion", "ownerTicket", "cases"],
          "properties": {
            "$schema": {},
            "schema": { "enum": ["jqstar-csp-denied/1", "jqstar-csp-adversarial/1"] },
            "grammarVersion": {},
            "ownerTicket": { "const": "0034" },
            "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rejectedCase" } }
          }
        }
      ]
    },
    "callBehavior": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": { "kind": { "const": "return-data" }, "value": true }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "sum-numbers" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "returnValue"],
          "properties": { "kind": { "const": "return-function" }, "returnValue": true }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fulfillment"],
          "properties": { "kind": { "const": "return-thenable" }, "fulfillment": true }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fulfillment"],
          "properties": {
            "kind": { "const": "return-approved-async" },
            "fulfillment": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "rejectionLabel"],
          "properties": {
            "kind": { "const": "return-approved-async-rejection" },
            "rejectionLabel": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "selector"],
          "properties": {
            "kind": { "const": "return-canonical-jquery" },
            "selector": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "dataBindingStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "target", "value"],
      "properties": {
        "operation": { "const": "data-binding" },
        "target": { "enum": ["state", "computed", "args"] },
        "value": true
      }
    },
    "eventStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "type", "cancelable", "detail"],
      "properties": {
        "operation": { "const": "event" },
        "type": { "type": "string", "minLength": 1 },
        "cancelable": { "type": "boolean" },
        "detail": true
      }
    },
    "domTreeStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "markup", "rootSelector", "elementSelector"],
      "properties": {
        "operation": { "const": "dom-tree" },
        "markup": { "type": "string", "minLength": 1 },
        "rootSelector": { "type": "string", "minLength": 1 },
        "elementSelector": { "type": "string", "minLength": 1 }
      }
    },
    "domCollectionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "selector", "count"],
      "properties": {
        "operation": { "const": "dom-collection" },
        "selector": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "registeredActionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "name", "recordCalls", "behavior"],
      "properties": {
        "operation": { "const": "registered-action" },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*(?:\\.[A-Za-z_$][A-Za-z0-9_$-]*)*$"
        },
        "recordCalls": { "const": true },
        "behavior": { "$ref": "#/$defs/callBehavior" }
      }
    },
    "registeredHelperStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "path", "recordCalls", "behavior"],
      "properties": {
        "operation": { "const": "registered-helper" },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$"
        },
        "recordCalls": { "const": true },
        "behavior": { "$ref": "#/$defs/callBehavior" }
      }
    },
    "functionValueStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "target", "kind", "returnValue"],
      "properties": {
        "operation": { "const": "special-value" },
        "target": { "$ref": "#/$defs/contextTarget" },
        "kind": { "const": "function" },
        "returnValue": true
      }
    },
    "accessorValueStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "target", "kind", "getterValue", "expectedReads"],
      "properties": {
        "operation": { "const": "special-value" },
        "target": { "$ref": "#/$defs/contextTarget" },
        "kind": { "const": "accessor" },
        "getterValue": true,
        "expectedReads": { "const": 0 }
      }
    },
    "proxyValueStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "target", "kind", "trap", "thrownLabel", "expectedTrapCalls"],
      "properties": {
        "operation": { "const": "special-value" },
        "target": { "$ref": "#/$defs/contextTarget" },
        "kind": { "const": "throwing-descriptor-proxy" },
        "trap": { "const": "getOwnPropertyDescriptor" },
        "thrownLabel": { "$ref": "#/$defs/id" },
        "expectedTrapCalls": { "const": 1 }
      }
    },
    "cycleValueStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "target", "kind", "referenceTarget"],
      "properties": {
        "operation": { "const": "special-value" },
        "target": { "$ref": "#/$defs/contextTarget" },
        "kind": { "const": "self-cycle" },
        "referenceTarget": { "const": "state" }
      }
    },
    "foreignValueStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "target", "kind", "markup", "selector"],
      "properties": {
        "operation": { "const": "special-value" },
        "target": { "$ref": "#/$defs/contextTarget" },
        "kind": { "enum": ["foreign-dom-element", "foreign-jquery"] },
        "markup": { "type": "string", "minLength": 1 },
        "selector": { "type": "string", "minLength": 1 }
      }
    },
    "contextTarget": {
      "type": "string",
      "pattern": "^(?:state|evt\\.detail)(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$"
    },
    "contextStep": {
      "oneOf": [
        { "$ref": "#/$defs/dataBindingStep" },
        { "$ref": "#/$defs/eventStep" },
        { "$ref": "#/$defs/domTreeStep" },
        { "$ref": "#/$defs/domCollectionStep" },
        { "$ref": "#/$defs/registeredActionStep" },
        { "$ref": "#/$defs/registeredHelperStep" },
        { "$ref": "#/$defs/functionValueStep" },
        { "$ref": "#/$defs/accessorValueStep" },
        { "$ref": "#/$defs/proxyValueStep" },
        { "$ref": "#/$defs/cycleValueStep" },
        { "$ref": "#/$defs/foreignValueStep" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "transition"],
          "properties": {
            "operation": { "const": "engine-lifecycle" },
            "transition": { "const": "dispose-before-evaluation" }
          }
        }
      ]
    },
    "contextManifest": {
      "allOf": [
        { "$ref": "#/$defs/manifestHeader" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["$schema", "schema", "grammarVersion", "ownerTicket", "fixtures"],
          "properties": {
            "$schema": {},
            "schema": { "const": "jqstar-csp-contexts/1" },
            "grammarVersion": {},
            "ownerTicket": { "const": "0034" },
            "fixtures": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "description", "steps"],
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "description": { "type": "string", "minLength": 1 },
                  "steps": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/contextStep" }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "attribute"],
      "properties": {
        "path": { "type": "string", "pattern": "^(README\\.md|registry/|example/|e2e/)" },
        "line": { "type": "integer", "minimum": 1 },
        "attribute": { "type": "string", "pattern": "^data-" }
      }
    },
    "publicExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "locations", "disposition", "caseId", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source": { "type": "string" },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceLocation" }
        },
        "disposition": {
          "enum": [
            "exact-parity",
            "csp-equivalent",
            "migration-required",
            "intentionally-unsupported"
          ]
        },
        "caseId": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1 },
        "equivalent": { "type": "string", "minLength": 1 }
      }
    },
    "mappedCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "disposition", "downstreamCaseId", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "disposition": {
          "enum": [
            "exact-parity",
            "csp-equivalent",
            "migration-required",
            "intentionally-unsupported"
          ]
        },
        "downstreamCaseId": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1 },
        "equivalent": { "type": "string", "minLength": 1 }
      }
    },
    "conformanceMap": {
      "allOf": [
        { "$ref": "#/$defs/manifestHeader" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "$schema",
            "schema",
            "grammarVersion",
            "ownerTicket",
            "inventoryScope",
            "featureCases",
            "sharedCases",
            "publicExamples"
          ],
          "properties": {
            "$schema": {},
            "schema": { "const": "jqstar-csp-conformance-map/1" },
            "grammarVersion": {},
            "ownerTicket": { "const": "0035" },
            "inventoryScope": {
              "type": "object",
              "additionalProperties": false,
              "required": ["roots", "extensions", "extractorVersion"],
              "properties": {
                "roots": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "prefixItems": [
                    { "const": "README.md" },
                    { "const": "registry" },
                    { "const": "example" },
                    { "const": "e2e" }
                  ],
                  "items": false
                },
                "extensions": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "prefixItems": [{ "const": ".html" }, { "const": ".md" }, { "const": ".ts" }],
                  "items": false
                },
                "extractorVersion": { "const": "jqstar-public-expression-inventory/1" }
              }
            },
            "featureCases": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/mappedCase" }
            },
            "sharedCases": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/mappedCase" }
            },
            "publicExamples": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/publicExample" }
            }
          }
        }
      ]
    }
  }
}
