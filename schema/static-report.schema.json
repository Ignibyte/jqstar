{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ignibyte.github.io/jqstar/schema/static-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "mode",
    "status",
    "startedAt",
    "endedAt",
    "selectedGateCount",
    "gates"
  ],
  "properties": {
    "schema": { "const": "jqstar-static-report/1" },
    "runId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["fast", "delivery", "full-audit"] },
    "status": { "enum": ["pass", "fail", "error"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "selectedGateCount": { "type": "integer", "minimum": 1 },
    "interruptedBy": { "enum": ["SIGINT", "SIGTERM"] },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "enforced"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail", "error"] },
          "enforced": { "const": true }
        }
      }
    }
  }
}
