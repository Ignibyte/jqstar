            "kind": {
              "const": "action"
            },
            "phase": {
              "enum": ["started", "completed", "cancelled", "failed"]
            },
            "outcome": {
              "enum": ["pending", "completed", "cancelled", "failed"]
            },
            "elapsedMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "id": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^(store-)?operation-[1-9][0-9]*$"
            },
            "ownerId": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^(application-[1-9][0-9]*|core\\.stores)$"
            },
            "actionCapability": {
              "type": "string",
              "maxLength": 96,
              "pattern": "^[a-z][a-zA-Z0-9]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence",
            "kind",
            "phase",
            "outcome",
            "elapsedMs",
            "id",
            "ownerId",
            "method",
            "attempt"
          ],
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "kind": {
              "const": "request"
            },
            "phase": {
              "enum": ["started", "progress", "retrying", "completed", "cancelled", "failed"]
            },
            "outcome": {
              "enum": ["pending", "completed", "cancelled", "failed"]
            },
            "elapsedMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "id": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^(store-)?operation-[1-9][0-9]*$"
            },
            "ownerId": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^(application-[1-9][0-9]*|core\\.stores)$"
            },
            "method": {
              "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
            },
            "attempt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "status": {
              "type": "integer",
              "minimum": 0,
              "maximum": 599
            },
            "parentId": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^operation-[1-9][0-9]*$"
            },
            "loaded": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence",
            "kind",
            "phase",
            "outcome",
            "elapsedMs",
            "id",
            "ownerId",
            "category"
          ],
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "kind": {
              "const": "store"
            },
            "phase": {
              "enum": ["completed", "cancelled", "failed"]
            },
            "outcome": {
              "enum": ["pending", "completed", "cancelled", "failed"]
            },
            "elapsedMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "id": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^(store-)?operation-[1-9][0-9]*$"
            },
            "ownerId": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^(application-[1-9][0-9]*|core\\.stores)$"
            },
            "category": {
              "enum": ["cleanup", "definition", "effect", "setup", "subscription", "task", "change"]
            },
            "storeName": {
              "type": "string",
              "maxLength": 96,
              "pattern": "^[a-z][a-zA-Z0-9]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence",
            "kind",
            "phase",
            "outcome",
            "elapsedMs",
            "id",
            "category",
            "removals"
          ],
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "kind": {
              "enum": ["turbo", "htmx"]
            },
            "phase": {
              "enum": [
                "prepared",
                "removing",
                "externally-mutated",
                "enhancing",
                "committed",
                "canceled",
                "failed"
              ]
            },
            "outcome": {
              "enum": ["pending", "completed", "cancelled", "failed"]
            },
            "elapsedMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "id": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^(turbo|htmx)-[1-9][0-9]*$"
            },
            "category": {
              "enum": ["document", "frame", "region", "out-of-band", "history"]
            },
            "removals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "renderId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sequence", "kind", "phase", "outcome", "elapsedMs", "field", "policyId"],
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "kind": {
              "const": "policy"
            },
            "phase": {
              "enum": ["allowed", "denied", "expired"]
            },
            "outcome": {
              "const": "completed"
            },
            "elapsedMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "field": {
              "enum": ["actionCapability", "storeName"]
            },
            "policyId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        }
      ]
    },
