    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applications",
        "applicationCount",
        "plugins",
        "pluginCount",
        "serviceCount",
        "ownership",
        "pendingEnhancements",
        "pendingTasks",
        "protocolProfiles",
        "protocolBodies",
        "middleware",
        "expression"
      ],
      "properties": {
        "applications": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "mode"],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^application-[1-9][0-9]*$"
              },
              "mode": {
                "enum": ["attributes", "behavior"]
              }
            }
          }
        },
        "applicationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "plugins": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
              },
              "version": {
                "type": "string",
                "maxLength": 32,
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              }
            }
          }
        },
        "pluginCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "serviceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["effect", "listener", "observer", "service", "subscription", "task"],
          "properties": {
            "effect": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "listener": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "observer": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "service": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "subscription": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "task": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "pendingEnhancements": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pendingTasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "protocolProfiles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "protocolBodies": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "middleware": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expression": {
          "const": "installed"
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kernelId", "trace", "records"],
      "properties": {
        "schema": {
          "const": "jqstar-inspection-trace/1"
        },
        "kernelId": {
          "type": "string",
          "maxLength": 39,
          "pattern": "^kernel-[0-9a-f]{32}$"
        },
        "trace": {
          "$ref": "#/$defs/traceState"
        },
        "records": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/record"
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "kernelId",
        "sequence",
        "lifecycle",
        "kernel",
        "services",
        "omitted",
        "trace",
        "disposal"
      ],
      "properties": {
        "schema": {
          "const": "jqstar-inspection-snapshot/1"
        },
        "version": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "kernelId": {
          "type": "string",
          "maxLength": 39,
          "pattern": "^kernel-[0-9a-f]{32}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "lifecycle": {
          "enum": ["active", "disposed", "released"]
        },
        "kernel": {
          "anyOf": [
            {
              "$ref": "#/$defs/kernel"
            },
            {
              "type": "null"
            }
          ]
        },
        "services": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/service"
          }
        },
        "omitted": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applications", "plugins", "services"],
          "properties": {
            "applications": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "plugins": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "services": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "trace": {
          "$ref": "#/$defs/traceState"
        },
        "disposal": {
          "anyOf": [
            {
              "$ref": "#/$defs/disposal"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
