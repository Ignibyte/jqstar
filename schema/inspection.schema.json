{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jqstar.com/schema/inspection.schema.json",
  "title": "jQStar bounded inspection documents",
  "oneOf": [
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/trace"
    },
    {
      "$ref": "#/$defs/service"
    }
  ],
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "schema", "boundary", "counts"],
      "properties": {
        "namespace": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
        },
        "schema": {
          "const": "jqstar-service-counts/1"
        },
        "boundary": {
          "enum": ["capabilities", "service-resources", "attachments", "bridge"]
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "installed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "capabilities": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "records": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "subscriptions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "effects": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "tasks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "attachments": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "pending": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "disabled": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "disposed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "renders": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "observers": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "waiters": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "history": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "requests": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "listeners": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "purpose", "maxLength", "retain", "export", "expiresInMs"],
      "properties": {
        "field": {
          "enum": ["actionCapability", "storeName"]
        },
        "purpose": {
          "enum": ["debugging", "support"]
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 96
        },
        "retain": {
          "type": "boolean"
        },
        "export": {
          "type": "boolean"
        },
        "expiresInMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed",
        "filtered",
        "sampled",
        "retained",
        "evicted",
        "oversized",
        "purged",
        "failures"
      ],
      "properties": {
        "observed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "filtered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sampled": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "retained": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evicted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "oversized": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "purged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failures": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configuration",
            "capture",
            "serializer",
            "reentrant",
            "clock",
            "export",
            "cleanup"
          ],
          "properties": {
            "configuration": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "capture": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "serializer": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reentrant": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "clock": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "export": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cleanup": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "traceState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "maxEntries",
            "maxBytes",
            "entries",
            "bytes",
            "sequence",
            "policyId",
            "kinds",
            "outcomes",
            "everyNth",
            "policies",
            "counters"
          ],
          "properties": {
            "enabled": {
              "const": true
            },
            "maxEntries": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 2,
              "maximum": 1048576
            },
            "entries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "bytes": {
              "type": "integer",
              "minimum": 2,
              "maximum": 1048576
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "policyId": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "kinds": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "enum": ["action", "request", "store", "turbo", "htmx", "policy"]
              },
              "uniqueItems": true
            },
            "outcomes": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "enum": ["pending", "completed", "cancelled", "failed"]
              },
              "uniqueItems": true
            },
            "everyNth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "policies": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/policy"
              }
            },
            "counters": {
              "$ref": "#/$defs/counters"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "maxEntries",
            "maxBytes",
            "entries",
            "bytes",
            "sequence",
            "policyId",
            "kinds",
            "outcomes",
            "everyNth",
            "policies",
            "counters"
          ],
          "properties": {
            "enabled": {
              "const": false
            },
            "maxEntries": {
              "const": 0
            },
            "maxBytes": {
              "const": 0
            },
            "entries": {
              "const": 0
            },
            "bytes": {
              "const": 0
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "policyId": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "kinds": {
              "type": "array",
              "maxItems": 0,
              "items": {
                "enum": ["action", "request", "store", "turbo", "htmx", "policy"]
              }
            },
            "outcomes": {
              "type": "array",
              "maxItems": 0,
              "items": {
                "enum": ["pending", "completed", "cancelled", "failed"]
              }
            },
            "everyNth": {
              "const": 1
            },
            "policies": {
              "type": "array",
              "maxItems": 0,
              "items": {
                "$ref": "#/$defs/policy"
              }
            },
            "counters": {
              "$ref": "#/$defs/counters"
            }
          }
        }
      ]
    },
    "record": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sequence", "kind", "phase", "outcome", "elapsedMs", "id", "ownerId"],
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
