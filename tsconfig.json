{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "jquery-star": ["./src/index.ts"],
      "jquery-star/core": ["./src/core.ts"],
      "jquery-star/datastar": ["./src/datastar.ts"],
      "jquery-star/testing": ["./src/testing/index.ts"],
      "jquery-star/datastar/testing": ["./src/datastar/testing.ts"],
      "jquery-star/ui": ["./src/ui.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "types": ["jquery", "node", "vitest/globals"]
  },
  "include": ["src", "server", "test", "e2e", "example", "scripts/**/*.d.mts", "*.config.ts"]
}
