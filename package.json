{
  "name": "jquery-star",
  "version": "0.1.0",
  "description": "Datastar-style reactive attributes with real jQuery expressions",
  "type": "module",
  "license": "MIT",
  "homepage": "https://ignibyte.github.io/jqstar/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ignibyte/jqstar.git"
  },
  "bugs": {
    "url": "https://github.com/Ignibyte/jqstar/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "jquery",
    "reactivity",
    "declarative",
    "datastar",
    "signals"
  ],
  "main": "./dist/jquery-star.umd.cjs",
  "module": "./dist/jquery-star.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/jquery-star.js",
      "require": "./dist/jquery-star.umd.cjs"
    },
    "./ui.css": "./dist/jquery-star-ui.css"
  },
  "bin": {
    "jqstar": "./bin/jqstar.mjs"
  },
  "files": [
    "bin",
    "deploy",
    "dist",
    "docs/SELF_HOSTING.md",
    "LICENSE",
    "README.md",
    "registry",
    "registry.json",
    "schema"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:js && npm run build:css",
    "build:css": "tailwindcss -i ./src/ui/theme.css -o ./dist/jquery-star-ui.css --minify",
    "build:demo": "vite build --config vite.demo.config.ts",
    "build:pages": "JQS_SITE_BASE=/jqstar/ JQS_STATIC_DEMO=true npm run build:demo",
    "build:js": "vite build && tsc -p tsconfig.build.json",
    "build:self-hosted": "npm run build && npm run build:demo && npm run build:server",
    "build:server": "vite build --config vite.server.config.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:self-hosted && npm run test:e2e",
    "clean": "rimraf dist demo-dist server-dist coverage playwright-report registry-dist test-results",
    "demo": "vite --config vite.demo.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src server test example e2e bin scripts *.config.ts",
    "registry:list": "node ./bin/jqstar.mjs list",
    "publish:pages": "npm run check && npm run test:package && npm run build:pages && gh-pages -d demo-dist -m \"Publish jqstar catalog\"",
    "test": "npm run test:unit",
    "test:e2e": "playwright test",
    "test:package": "npm run build && node scripts/smoke-built.mjs && node scripts/smoke-package-files.mjs",
    "test:self-hosted": "npm run build:self-hosted && node scripts/smoke-deployment.mjs && node scripts/smoke-server.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.registry.json",
    "serve:self-hosted": "node server-dist/index.mjs"
  },
  "peerDependencies": {
    "jquery": ">=4.0.0 <5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jquery": "^3.5.32",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^6.3.0",
    "globals": "^17.11.0",
    "jquery": "^4.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@starfederation/datastar-sdk": "^1.0.0",
    "idiomorph": "^0.7.4",
    "json5": "^2.2.3"
  }
}
