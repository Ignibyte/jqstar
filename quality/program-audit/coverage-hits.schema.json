{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "minProperties": 1,
  "maxProperties": 10000,
  "additionalProperties": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "all": {
        "type": "boolean"
      },
      "statementMap": {
        "type": "object",
        "maxProperties": 100000,
        "propertyNames": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 12
        },
        "additionalProperties": {
          "$ref": "#/$defs/location"
        }
      },
      "s": {
        "type": "object",
        "maxProperties": 100000,
        "propertyNames": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 12
        },
        "additionalProperties": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "fnMap": {
        "type": "object",
        "maxProperties": 100000,
        "propertyNames": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 12
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 4096
            },
            "decl": {
              "$ref": "#/$defs/location"
            },
            "loc": {
              "$ref": "#/$defs/location"
            },
            "line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": ["name", "decl", "loc", "line"],
          "additionalProperties": false
        }
      },
      "f": {
        "type": "object",
        "maxProperties": 100000,
        "propertyNames": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 12
        },
        "additionalProperties": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "branchMap": {
        "type": "object",
        "maxProperties": 100000,
        "propertyNames": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 12
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "type": {
              "const": "branch"
            },
            "line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "loc": {
              "$ref": "#/$defs/location"
            },
            "locations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "items": {
                "$ref": "#/$defs/location"
              }
            }
          },
          "required": ["type", "line", "loc", "locations"],
          "additionalProperties": false
        }
      },
      "b": {
        "type": "object",
        "maxProperties": 100000,
        "propertyNames": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 12
        },
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "required": ["path", "all", "statementMap", "s", "fnMap", "f", "branchMap", "b"],
    "additionalProperties": false
  },
  "$defs": {
    "position": {
      "type": "object",
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["line", "column"],
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/position"
        },
        "end": {
          "$ref": "#/$defs/position"
        }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    }
  }
}
