{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "minProperties": 2,
  "maxProperties": 10001,
  "properties": {
    "total": {
      "type": "object",
      "properties": {
        "lines": {
          "$ref": "#/$defs/metric"
        },
        "functions": {
          "$ref": "#/$defs/metric"
        },
        "statements": {
          "$ref": "#/$defs/metric"
        },
        "branches": {
          "$ref": "#/$defs/metric"
        },
        "branchesTrue": {
          "const": {
            "total": 0,
            "covered": 0,
            "skipped": 0,
            "pct": 100
          }
        }
      },
      "required": ["lines", "functions", "statements", "branches"],
      "additionalProperties": false
    }
  },
  "required": ["total"],
  "additionalProperties": {
    "type": "object",
    "properties": {
      "lines": {
        "$ref": "#/$defs/metric"
      },
      "functions": {
        "$ref": "#/$defs/metric"
      },
      "statements": {
        "$ref": "#/$defs/metric"
      },
      "branches": {
        "$ref": "#/$defs/metric"
      }
    },
    "required": ["lines", "functions", "statements", "branches"],
    "additionalProperties": false
  },
  "$defs": {
    "metric": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "covered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "skipped": {
          "const": 0
        },
        "pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": ["total", "covered", "skipped", "pct"],
      "additionalProperties": false
    }
  }
}
