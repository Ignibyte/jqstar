{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "source",
    "inputs",
    "tickets",
    "requirements",
    "claimCandidates",
    "unresolved"
  ],
  "properties": {
    "schema": {
      "const": "jqstar-program-audit-inventory/1"
    },
    "status": {
      "const": "review-required"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "mutableWorkspace", "fingerprint"],
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "mutableWorkspace": {
          "type": "boolean"
        },
        "fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "digest", "fileCount"],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "fileCount": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2097152
          }
        }
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "status", "role", "criteria"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "enum": ["planned", "coding", "testing", "documenting", "done", "declined", "blocked"]
          },
          "role": {
            "enum": ["self", "deferred", "prerequisite"]
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]{2}$"
            },
            "minItems": 1,
            "maxItems": 99,
            "uniqueItems": true
          }
        }
      },
      "minItems": 53,
      "maxItems": 53
    },
    "requirements": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "owner", "criterion", "text", "disposition", "recordedEvidence"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              },
              "owner": {
                "type": "string",
                "pattern": "^[0-9]{4}$"
              },
              "criterion": {
                "type": "string",
                "pattern": "^AC-[0-9]{2}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              },
              "disposition": {
                "enum": ["Pass", "Approved-Disposition"]
              },
              "recordedEvidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "owner", "text", "disposition"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^program:AC-[0-9]{2}$"
              },
              "owner": {
                "const": "0033"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              },
              "disposition": {
                "const": "required"
              }
            }
          }
        ]
      },
      "minItems": 613,
      "maxItems": 613
    },
    "claimCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "source", "sourceSha256", "line", "text", "disposition"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "owner": {
            "const": "0033"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$"
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2097152
          },
          "disposition": {
            "const": "unreviewed"
          }
        }
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "unresolved": {
      "const": [
        "semantic-claim-review",
        "direct-requirement-mappings",
        "final-immutable-manifest",
        "current-evidence-execution",
        "nvda-windows",
        "voiceover-safari"
      ]
    }
  }
}
