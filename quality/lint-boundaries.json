{
  "schema": "jqstar-lint-boundaries/1",
  "ownerTicket": "0052",
  "reviewedAt": "2026-09-06",
  "reviewAfter": "2027-03-03",
  "rules": [
    {
      "rule": "@typescript-eslint/no-base-to-string",
      "reason": "Existing public coercion and formatting boundaries; each use remains reviewable legacy debt rather than proof that arbitrary object stringification is useful."
    },
    {
      "rule": "@typescript-eslint/no-dynamic-delete",
      "reason": "Existing removal from mutable owned dictionaries; changing delete to a different operation requires preserving proxy and strict-mode behavior."
    },
    {
      "rule": "@typescript-eslint/no-non-null-assertion",
      "reason": "Existing indexed-access, lifecycle-precondition, DOM, and fixture assertions. This allowance records remaining assertions and does not claim all preconditions are statically proved."
    },
    {
      "rule": "@typescript-eslint/no-this-alias",
      "reason": "Existing callback receiver capture; preserve the documented jQuery receiver while reviewing replacement structure."
    },
    {
      "rule": "@typescript-eslint/no-unnecessary-condition",
      "reason": "Existing defensive checks for JavaScript callers and closure state that TypeScript narrows more strongly; retain runtime validation until individually reviewed."
    },
    {
      "rule": "@typescript-eslint/no-unnecessary-type-conversion",
      "reason": "Existing runtime coercion for signals and JavaScript input; compile-time primitive types alone do not prove the value supplied at runtime."
    },
    {
      "rule": "@typescript-eslint/no-unnecessary-type-parameters",
      "reason": "Existing public generic inference and caller-selected type contracts; type-surface changes need consumer and API evidence."
    }
  ],
