{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ignibyte.github.io/jqstar/schema/quality-scopes.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scopes"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "jqstar-quality-scopes/1" },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "match", "required", "validators"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "match": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "validators": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
