{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD025": false,
    "MD033": false,
    "MD036": false,
    "MD041": false,
    "MD060": false,
  },
  "globs": ["**/*.md"],
  "ignores": [
    ".git/**",
    "node_modules/**",
    "dist/**",
    "demo-dist/**",
    "registry-dist/**",
    "server-dist/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    ".quality-reports/**",
    ".stryker-tmp/**",
  ],
}
