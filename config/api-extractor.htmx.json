{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "mainEntryPointFilePath": "<projectFolder>/dist/types/htmx.d.ts",
  "compiler": { "tsconfigFilePath": "<projectFolder>/config/tsconfig.api-extractor.json" },
  "apiReport": {
    "enabled": true,
    "reportFileName": "jquery-star-htmx.api.md",
    "reportFolder": "<projectFolder>/etc",
    "reportTempFolder": "<projectFolder>/.git/jqstar/api-report"
  },
  "docModel": { "enabled": false },
  "dtsRollup": {
    "enabled": true,
    "untrimmedFilePath": "<projectFolder>/dist/htmx.d.ts"
  },
  "tsdocMetadata": { "enabled": false },
  "messages": {
    "extractorMessageReporting": {
      "ae-missing-release-tag": { "logLevel": "none" }
    }
  }
}
